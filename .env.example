# Clave del backend. No uses el prefijo VITE_ porque quedaría expuesta al navegador.
GOOGLE_PLACES_API_KEY=

# Versión vigente comprobada de Graph API para Instagram oEmbed.
META_GRAPH_API_VERSION=v26.0

# Enriquecimiento best-effort con la respuesta JSON oEmbed de instagram.com.
# No descarga vídeos ni conserva miniaturas CDN. Activo por defecto; permite opt-out.
INSTAGRAM_PUBLIC_OEMBED_ENRICHMENT=true

# Token de la app de Meta oEmbed Read, si tu configuración de Meta lo exige.
# No es el token de usuario de Instagram usado por Business Discovery.
META_OEMBED_ACCESS_TOKEN=

# Cuenta profesional propia desde la que se consulta Business Discovery.
# El token debe ser un Facebook User Access Token de la MISMA app de Meta y tener
# instagram_basic, instagram_manage_insights y pages_read_engagement.
META_INSTAGRAM_USER_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# En desarrollo muestra en la terminal de npm run dev las URLs normalizadas,
# cuentas detectadas, campos oficiales disponibles, consultas y resultados Places.
# Nunca registra tokens, HTML o URLs temporales de CDN.
INSTAGRAM_DEBUG_LOGS=true

# Puerto del backend local.
PORT=8787

# Orígenes permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
